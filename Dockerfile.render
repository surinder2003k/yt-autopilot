# yt-autopilot — Render.com deployment (Playwright pre-installed)
FROM mcr.microsoft.com/playwright/python:v1.46.0-jammy

WORKDIR /app
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Only install ffmpeg (already in base) + python deps
COPY requirements.txt ./
RUN pip install --no-cache-dir --retries 5 --timeout 120 -r requirements.txt

COPY . .

RUN chmod +x render-start.sh && mkdir -p storage/tasks storage/cache_videos

EXPOSE 8080

CMD ["bash", "render-start.sh"]