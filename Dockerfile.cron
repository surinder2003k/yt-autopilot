# Cron-only image: har 6 ghante autopilot run karta hai (Playwright pre-installed)
FROM mcr.microsoft.com/playwright/python:v1.46.0-jammy

WORKDIR /app
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Only install ffmpeg (already in base) + python deps
COPY requirements.txt ./
RUN pip install --no-cache-dir --retries 5 --timeout 120 -r requirements.txt

COPY . .

RUN mkdir -p storage/tasks storage/cache_videos

# Run autopilot once per cron trigger, then exit
CMD ["python", "autopilot.py"]